# Copy this file to `.env` for local development, and add the same variables
# in your hosting dashboard (Vercel → Project → Settings → Environment Variables).
# Never commit the real `.env` file.

# --- AI chat guide -------------------------------------------------------
# Option A (free tier): Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model. "-latest" aliases follow Google's current models; if this
# one is busy, the server falls back to gemini-flash-latest automatically.
GEMINI_MODEL=gemini-flash-lite-latest

# Option B (paid): Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: Claude model.
AI_MODEL=claude-haiku-5-5

# Optional: force a provider ("gemini" or "claude"). Empty = use whichever key
# is set, Gemini first. Leave commented out unless you need it.
# AI_PROVIDER=gemini

# Optional: max questions per visitor (IP) per hour.
CHAT_RATE_LIMIT=20
