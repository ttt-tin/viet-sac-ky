---
import type { Member } from '../data/team';
interface Props {
  member: Member;
}
const { member } = Astro.props;
const color = `var(--${member.accent})`;
---
<article class="card member">
  {member.avatar ? (
    <img class="member__avatar" src={member.avatar} alt={`Ảnh đại diện của ${member.name}`} width="92" height="92" loading="lazy" />
  ) : (
    <div class="member__avatar member__avatar--initials" style={`background:${color}`} aria-hidden="true">{member.initials}</div>
  )}
  <div>
    <h3 class="member__name">{member.name}</h3>
    <p class="member__role" style={`color:${color}`}>{member.role}</p>
    <p class="small">{member.tasks}</p>
  </div>
</article>

<style>
  .member { display: flex; gap: 20px; align-items: center; padding: 24px; }
  .member__avatar { width: 92px; height: 92px; border-radius: 50%; flex-shrink: 0; object-fit: cover; }
  .member__avatar--initials { display: grid; place-items: center; font-family: var(--font-serif); font-weight: 600; font-size: 28px; color: #fff7ee; }
  .member__name { font-family: var(--font-serif); font-weight: 600; font-size: 21px; line-height: 1.3; }
  .member__role { font-size: 14px; font-weight: 600; }
</style>
