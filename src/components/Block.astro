---
// Renders one content block from an ethnic-group YAML file.
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { inline, paragraphs } from '../lib/text';
import { getPhoto } from '../data/photos';

type Block = CollectionEntry<'ethnicGroups'>['data']['sections'][number]['blocks'][number];
interface Props {
  block: Block;
}
const { block } = Astro.props;

// Large versions for the lightbox (gallery only).
const gallery =
  block.type === 'gallery'
    ? await Promise.all(
        block.items.map(async (item) => {
          const src = getPhoto(item.photo);
          const full = src ? await getImage({ src, width: Math.min(src.width, 1600) }) : undefined;
          return { ...item, src, full: full?.src };
        }),
      )
    : [];
---
{block.type === 'text' && <div class="prose b-text" set:html={paragraphs(block.body)} />}

{block.type === 'did' && (
  <aside class="did">
    <p class="did__title">{block.title}</p>
    <div set:html={paragraphs(block.body)} />
  </aside>
)}

{block.type === 'badge' && (
  <p class="badge"><Icon name="star" size={16} />{block.text}</p>
)}

{block.type === 'figure' && (
  <div class="b-figure">
    <Photo
      photo={block.placeholder ? undefined : block.photo}
      illustration={block.placeholder ? undefined : block.illustration}
      caption={block.caption}
      credit={block.credit}
    />
  </div>
)}

{block.type === 'cards' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <div class="b-cards" style={`--cols:${block.columns}`}>
      {block.items.map((item) => (
        <div class:list={['card b-card', { 'b-card--photo': item.photo }]}>
          {item.photo && getPhoto(item.photo) && (
            <figure class="b-card__media">
              <Image src={getPhoto(item.photo)!} alt={item.name} widths={[320, 640]} sizes="(max-width: 520px) 100vw, 360px" />
              {item.credit && <figcaption>Ảnh: {item.credit}</figcaption>}
            </figure>
          )}
          <p class="b-card__name">{item.name}</p>
          {item.sub && <p class="small">{item.sub}</p>}
          {item.body && <p class="b-card__body" set:html={inline(item.body)} />}
        </div>
      ))}
    </div>
  </div>
)}

{block.type === 'steps' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <ol class="b-steps">
      {block.items.map((item, i) => (
        <li class:list={['card b-step', { 'b-step--photo': item.photo }]}>
          <span class="b-step__n" aria-hidden="true">{i + 1}</span>
          <div class="b-step__text">
            <p class="b-step__title">{item.title}</p>
            <p class="small" set:html={inline(item.body)} />
          </div>
          {item.photo && getPhoto(item.photo) && (
            <figure class="b-step__media">
              <Image src={getPhoto(item.photo)!} alt={item.title} widths={[320, 640]} sizes="240px" />
              {item.credit && <figcaption>Ảnh: {item.credit}</figcaption>}
            </figure>
          )}
        </li>
      ))}
    </ol>
  </div>
)}

{block.type === 'compare' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <div class="b-compare">
      {block.items.map((item) => (
        <div class="card b-compare__col">
          <p class="h3">{item.title}</p>
          <ul>{item.points.map((p) => <li set:html={inline(p)} />)}</ul>
        </div>
      ))}
    </div>
  </div>
)}

{block.type === 'phrases' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <dl class="b-phrases">
      {block.items.map((item) => (
        <div class="b-phrase">
          <dt>{item.local}</dt>
          <dd>{item.vi}</dd>
        </div>
      ))}
    </dl>
  </div>
)}

{block.type === 'list' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <ul class="b-list">{block.items.map((p) => <li set:html={inline(p)} />)}</ul>
  </div>
)}

{block.type === 'gallery' && (
  <div class="b-group">
    {block.title && <p class="caption b-title">{block.title}</p>}
    <ul class:list={['b-gallery', `b-gallery--${Math.min(gallery.length, 3)}`]}>
      {gallery.map((item, i) => item.src && (
        <li>
          <figure class="b-gallery__item" style={`--tilt:${[-1.2, 0.8, -0.4][i % 3]}deg`}>
            <button type="button" class="b-gallery__open" data-lightbox={item.full} data-caption={`${item.caption} · Ảnh: ${item.credit}`} aria-label={`Phóng to ảnh: ${item.caption}`}>
              <Image src={item.src} alt={item.caption} widths={[400, 800]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px" />
            </button>
            <figcaption>
              <span class="caption">{item.caption}</span>
              <span class="b-credit">Ảnh: {item.credit}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .b-text { max-width: 760px; }
  .b-figure { max-width: 620px; padding-block: 12px; }
  .b-title { margin-bottom: 12px; }
  .b-cards { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 16px; }
  .b-card { padding: 18px 20px; }
  .b-card__name { font-family: var(--font-serif); font-weight: 600; font-size: 20px; line-height: 1.3; }
  .b-card__body { font-size: 15px; line-height: 1.55; margin-top: 6px; }
  .b-steps { list-style: none; padding: 0; display: grid; gap: 12px; max-width: 820px; }
  .b-step { display: flex; gap: 18px; padding: 20px 22px; align-items: flex-start; }
  .b-step__n { width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%; background: var(--accent); color: #fff7ee; display: grid; place-items: center; font-family: var(--font-serif); font-weight: 700; font-size: 20px; }
  .b-step__title { font-weight: 600; font-size: 17px; }
  .b-compare { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .b-compare__col { padding: 24px; border-top: 4px solid var(--accent); }
  .b-compare__col ul { margin-top: 12px; padding-left: 20px; display: grid; gap: 8px; font-size: 16px; }
  .b-phrases { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .b-phrase { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .b-phrase dt { font-family: var(--font-serif); font-weight: 600; font-size: 22px; color: var(--accent); }
  .b-phrase dd { margin: 0; font-size: 14px; color: var(--ink-soft); }
  .b-list { padding-left: 22px; display: grid; gap: 8px; max-width: 760px; }
  .b-card--photo { padding: 12px 12px 18px; }
  .b-card__media { margin: 0 0 12px; }
  .b-card__media img, .b-step__media img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; }
  .b-card__media figcaption, .b-step__media figcaption, .b-credit { font-size: 11px; color: var(--ink-soft); margin-top: 4px; }
  .b-step--photo { display: grid; grid-template-columns: 44px minmax(0, 1fr) 220px; }
  .b-step__media { margin: 0; }
  .b-gallery { list-style: none; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .b-gallery--1 { grid-template-columns: minmax(0, 620px); }
  .b-gallery--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 960px; }
  .b-gallery__item { margin: 0; background: #fffdf8; padding: 8px 8px 12px; box-shadow: var(--shadow-photo); transform: rotate(var(--tilt, 0deg)); transition: transform 0.2s ease; }
  .b-gallery__item:hover { transform: rotate(0deg) scale(1.01); }
  .b-gallery__open { display: block; width: 100%; padding: 0; border: none; background: none; cursor: zoom-in; }
  .b-gallery__open img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .b-gallery__item figcaption { display: flex; flex-direction: column; margin-top: 8px; line-height: 1.35; }
  @media (max-width: 900px) {
    .b-cards, .b-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .b-step--photo { grid-template-columns: 44px minmax(0, 1fr); }
    .b-step__media { grid-column: 2; }
  }
  @media (max-width: 520px) {
    .b-cards, .b-gallery, .b-gallery--2 { grid-template-columns: 1fr; }
  }
</style>
